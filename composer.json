{
    "name": "uafrica/oauth-server",
    "description": "OAuth Server for CakePHP 3 using the PHP League's OAuth2 Server",
    "type": "cakephp-plugin",
    "version": "0.7.0",
    "keywords": [
        "cakephp",
        "oauth",
        "oauth2",
        "oauth server",
        "oauth2 server"
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://gitlab.ops.letstalk.nl/api/v4/group/42/-/packages/composer/packages.json"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.1",
        "league/oauth2-server": "~8.3",
        "cakephp/migrations": "*",
        "steverhoades/oauth2-openid-connect-server": "^2.4",
        "myclabs/php-enum": "^1.8",
        "symfony/options-resolver": "~3.4 || ~4.0 || ~5.0 || ~6.0",
        "lstrojny/functional-php": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "letstalk/code-quality": "^0.5",
        "cakephp/authentication": "*"
    },
    "autoload": {
        "psr-4": {
            "OAuthServer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests",
            "OAuthServer\\Test\\": "tests"
        }
    },
    "scripts": {
        "fix-permissions": [
            "OAuthServer\\Console\\Installer::postInstall"
        ],
        "post-develop": [
            "Composer\\Config::disableProcessTimeout",
            "lt-code-style",
            "lt-static-analysis",
            "lt-validate"
        ],
        "post-install-cmd": [
            "OAuthServer\\Console\\Installer::postInstall"
        ],
        "post-update-cmd": [
            "lt-composer-scripts",
            "lt-editorconfig"
        ],
        "pre-commit": [
            "Composer\\Config::disableProcessTimeout",
            "lt-code-style --staged --fail-on-fix",
            "lt-static-analysis --staged",
            "lt-validate"
        ],
        "test": [
            "@test-unit",
            "@test-integration",
            "@test-e2e",
            "vendor/bin/phpunit"
        ],
        "test-e2e": [
            "Composer\\Config::disableProcessTimeout",
            "lt-test e2e"
        ],
        "test-integration": [
            "Composer\\Config::disableProcessTimeout",
            "lt-test integration"
        ],
        "test-unit": [
            "Composer\\Config::disableProcessTimeout",
            "lt-test unit"
        ]
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Walther Lalk",
            "email": "walther@uafrica.com"
        },
        {
            "name": "Max van Holten",
            "email": "max@letstalk.nl"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
